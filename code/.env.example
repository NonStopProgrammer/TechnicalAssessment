# ---------------------------------------------------------------------------
# FinServ AI Regulatory Compliance Assistant — environment configuration
# Copy to `.env` and adjust. Every value has a safe MVP default baked into
# `shared/config.py`, so an empty .env still boots the stack in "local_stub"
# mode (no GPU, no external network calls, no API keys required).
# ---------------------------------------------------------------------------

# --- Runtime mode --------------------------------------------------------
# "local"  -> SQLite + embedded Qdrant + local_stub LLM/embedding providers.
#             Zero external infra, used for `pip install` + `pytest` and CI.
# "compose" -> Postgres + Qdrant server + Redis from docker-compose.yml,
#              still using local_stub providers by default (no GPU needed).
# "production" -> intended target: EKS, vLLM, HF TEI. See requirements/06-*.
ENVIRONMENT=local

# --- Database (RAG-5.4 registry, SEC-2 audit log, transactions, reports) --
# Local default needs nothing installed. docker-compose overrides this.
DATABASE_URL=sqlite:///./fincompliance.db

# --- Cache / session (LLM-2.5) --------------------------------------------
REDIS_URL=

# --- Vector store (RAG-3.2) ------------------------------------------------
# Leave QDRANT_URL empty to use Qdrant's embedded on-disk mode
# (QdrantClient(path=...)) — zero-infra local dev. Set to a URL
# (e.g. http://localhost:6333) to use the docker-compose / production server.
QDRANT_URL=
QDRANT_LOCAL_PATH=./.qdrant_data
QDRANT_API_KEY=

# --- Embeddings (RAG-3.1) --------------------------------------------------
# local_hash  -> deterministic, dependency-free, MVP default.
# tei         -> real BAAI/bge-large-en-v1.5 via HuggingFace TEI (production).
EMBEDDING_PROVIDER=local_hash
TEI_EMBEDDING_URL=http://localhost:8081

# --- Reranker (RAG-4.3) -----------------------------------------------------
# lexical  -> MVP default, dependency-free.
# cross_encoder -> real BAAI/bge-reranker-large via TEI rerank endpoint.
RERANKER_PROVIDER=lexical
TEI_RERANK_URL=http://localhost:8082

# --- Context compression (RAG-4.4) -----------------------------------------
# passthrough -> MVP default (light truncation only).
# llmlingua   -> production compressor.
COMPRESSION_PROVIDER=passthrough

# --- LLM orchestration (LLM-1, LLM-2) --------------------------------------
# local_stub -> deterministic, extractive, template-based generation.
#               No GPU/network/API key needed — this is what makes the MVP
#               runnable end-to-end without infra. See llm/providers/.
# vllm       -> real self-hosted Llama-3.1 via vLLM's OpenAI-compatible API.
LLM_ROUTER_PROVIDER=local_stub
LLM_GENERATION_PROVIDER=local_stub
VLLM_ROUTER_URL=http://localhost:8000/v1
VLLM_GENERATION_URL=http://localhost:8001/v1
LLM_ROUTING_CONFIG_PATH=./llm/config/model_routing.yaml
LLM_MODEL_REGISTRY_PATH=./llm/model_registry.yaml

# --- Guardrails (LLM-4) -----------------------------------------------------
PII_REDACTION_PROVIDER=regex
TOPICAL_RAIL_PROVIDER=keyword
CITATION_RELEVANCE_FLOOR=0.16

# --- Auth (SEC-2.1 / SEC-2.2) -----------------------------------------------
# dev_shared_secret -> HS256 JWT signed with JWT_SECRET, roles from claims.
#                       Standing in for Keycloak OIDC (see ADR / SEC-2.1).
AUTH_PROVIDER=dev_shared_secret
JWT_SECRET=change-me-in-every-real-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Observability (OBS-1) --------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173

# --- Agent graph (AGENT-2.2) ------------------------------------------------
AGENT_CHECKPOINTER=memory
AGENT_MAX_STEPS=12
AGENT_CONFIDENCE_THRESHOLD=0.6

# --- MCP server --------------------------------------------------------------
MCP_TRANSPORT=stdio
